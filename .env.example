# Analytics / marketing tracker IDs.
# These are all optional — with a variable unset, that tracker's script never
# loads (src/lib/tracking.ts no-ops it). Every one of them still only fires
# after a visitor accepts the relevant cookie category in the consent banner.
# Copy this file to .env.local and fill in the IDs once the accounts exist.

# Google Analytics 4 property (Admin > Data Streams > Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking (Tools > Conversions > tag setup)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta (Facebook/Instagram) Pixel ID (Events Manager > Data Sources)
NEXT_PUBLIC_META_PIXEL_ID=

# Lead notification email, sent via Resend (https://resend.com — free tier,
# no credit card needed). With RESEND_API_KEY or LEAD_NOTIFICATION_EMAIL
# unset, src/lib/email.ts no-ops and leads are only logged server-side, same
# as before. Server-only vars — never sent to the browser.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# Sender shown on the notification email. Must be on a domain verified in
# Resend. The sandbox address below works without verification but only
# delivers to the email of the Resend account itself — fine for testing.
LEAD_EMAIL_FROM=JS Garden Developers <onboarding@resend.dev>
