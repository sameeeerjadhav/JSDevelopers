# Analytics / marketing tracker IDs.
# These are all optional — with a variable unset, that tracker's script never
# loads (src/lib/tracking.ts no-ops it). Every one of them still only fires
# after a visitor accepts the relevant cookie category in the consent banner.
# Copy this file to .env.local and fill in the IDs once the accounts exist.

# Google Analytics 4 property (Admin > Data Streams > Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking (Tools > Conversions > tag setup)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta (Facebook/Instagram) Pixel ID (Events Manager > Data Sources)
NEXT_PUBLIC_META_PIXEL_ID=
